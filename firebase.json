{
  "hosting": {
    "public": "dist/deploy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build:firebase",
      "node scripts/assemble-firebase.mjs"
    ],
    "rewrites": [
      { "source": "/recipes", "destination": "/app.html" },
      { "source": "/recipes/**", "destination": "/app.html" },
      { "source": "/faqs", "destination": "/app.html" },
      { "source": "/faqs/**", "destination": "/app.html" },
      { "source": "/transformations", "destination": "/app.html" },
      { "source": "/transformations/**", "destination": "/app.html" },
      { "source": "/setup", "destination": "/app.html" },
      { "source": "/setup/**", "destination": "/app.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css|woff2|png|jpg|jpeg|gif|webp|svg|ico|pdf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
